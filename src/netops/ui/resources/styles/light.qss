/* NetOps Toolkit — 浅色现代主题
   调色板：底 #F6F8FB / 卡片 #FFFFFF / 描边 #E2E8F0 / 主色 #0F766E / 墨色 #0F172A
   所有控件状态都显式声明，避免继承 Qt 默认的灰白外观。 */

* {
    outline: 0;
}

QWidget {
    font-size: 13px;
    color: #0f172a;
}

QMainWindow,
#Root {
    background-color: #f6f8fb;
}

/* ───────────────── 左栏导航 ───────────────── */

#Sidebar {
    background-color: #ffffff;
    border-right: 1px solid #e2e8f0;
}

#Sidebar QScrollArea,
#Sidebar QScrollArea > QWidget > QWidget {
    background: transparent;
    border: none;
}

#SidebarBrand {
    color: #0b2f3f;
    font-size: 15px;
    font-weight: 700;
}

#SidebarBrandSub {
    color: #94a3b8;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1px;
}

#SidebarVersion {
    color: #94a3b8;
    font-size: 11px;
    padding: 2px 16px 10px 16px;
}

#SidebarFooter {
    border-top: 1px solid #eef2f7;
}

#NavSection {
    color: #94a3b8;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.2px;
    padding: 16px 22px 6px 22px;
}

QPushButton#NavItem {
    background: transparent;
    border: none;
    border-radius: 8px;
    color: #475569;
    font-size: 13px;
    text-align: left;
    padding: 0 12px 0 10px;
    min-height: 34px;
    max-height: 34px;
    margin: 1px 10px;
}

QPushButton#NavItem:hover {
    background-color: #f1f5f9;
    color: #0f172a;
}

QPushButton#NavItem:checked {
    background-color: #e6f4f2;
    color: #0f766e;
    font-weight: 600;
}

QPushButton#IconButton {
    background: transparent;
    border: none;
    border-radius: 7px;
    min-width: 28px;
    max-width: 28px;
    min-height: 28px;
    max-height: 28px;
}

QPushButton#IconButton:hover {
    background-color: #f1f5f9;
}

QToolButton#CollapseButton {
    background: transparent;
    border: none;
    border-radius: 7px;
    min-width: 28px;
    max-width: 28px;
    min-height: 28px;
    max-height: 28px;
}

QToolButton#CollapseButton:hover {
    background-color: #f1f5f9;
}

/* ───────────────── 主工作区 ───────────────── */

#Workspace {
    background-color: #f6f8fb;
}

#PageHeader {
    background-color: #ffffff;
    border: none;
    border-bottom: 1px solid #e2e8f0;
}

#PageTitle {
    color: #0f172a;
    font-size: 19px;
    font-weight: 700;
}

#PageSubtitle {
    color: #64748b;
    font-size: 12px;
}

#PageCrumb {
    color: #94a3b8;
    font-size: 12px;
}

#TopBarSearch {
    background-color: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    color: #64748b;
    font-size: 12px;
    padding: 6px 10px 6px 28px;
    min-width: 220px;
}

#TopBarSearch:focus {
    border: 1px solid #5eead4;
    background-color: #ffffff;
}

#TopBarKbd {
    color: #94a3b8;
    font-size: 11px;
}

#Badge {
    background-color: #f1f5f9;
    border-radius: 10px;
    color: #475569;
    font-size: 11px;
    font-weight: 600;
    padding: 3px 10px;
}

#BadgePrimary {
    background-color: #e6f4f2;
    border-radius: 10px;
    color: #0f766e;
    font-size: 11px;
    font-weight: 700;
    padding: 3px 10px;
}

#BadgeOutline {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    color: #64748b;
    font-size: 11px;
    font-weight: 600;
    padding: 3px 10px;
}

#StagePill {
    background-color: #fef3c7;
    border-radius: 11px;
    color: #92400e;
    font-size: 11px;
    font-weight: 700;
    padding: 4px 10px;
}

/* ───────────────── 卡片 ───────────────── */

#Card {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
}

#CardTitle {
    color: #0f172a;
    font-size: 14px;
    font-weight: 700;
}

#CardHint {
    color: #94a3b8;
    font-size: 12px;
}

#HeroCard {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
}

#HeroAccent {
    background-color: #0f766e;
    border-radius: 2px;
}

#HeroTitle {
    color: #0f172a;
    font-size: 22px;
    font-weight: 700;
}

#HeroSubtitle {
    color: #64748b;
    font-size: 13px;
}

#FeatureRow {
    color: #334155;
    font-size: 13px;
    padding: 3px 0;
}

#FeatureIndex {
    background-color: #f1f5f9;
    border-radius: 9px;
    color: #64748b;
    font-size: 10px;
    font-weight: 700;
    min-width: 18px;
    max-width: 18px;
    min-height: 18px;
    max-height: 18px;
}

#MetricValue {
    color: #0f172a;
    font-size: 18px;
    font-weight: 700;
}

#MetricLabel {
    color: #94a3b8;
    font-size: 11px;
}

#EmptyHint {
    color: #94a3b8;
    font-size: 12px;
}

#Notice {
    background-color: #f0f9ff;
    border: 1px solid #e0f2fe;
    border-radius: 9px;
    color: #0369a1;
    font-size: 12px;
    padding: 9px 12px;
}

#NoticeMuted {
    background-color: #f8fafc;
    border: 1px solid #eef2f7;
    border-radius: 9px;
    color: #64748b;
    font-size: 12px;
    padding: 9px 12px;
}

/* ───────────────── 代码预览 ───────────────── */

#CodeBlock {
    background-color: #0b1220;
    border: 1px solid #1e293b;
    border-radius: 10px;
}

#CodeBlockHeader {
    background-color: #0f172a;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom: 1px solid #1e293b;
}

#CodeBlockTitle {
    color: #94a3b8;
    font-size: 11px;
    font-weight: 600;
}

#CodeBlockQ {
    color: #64748b;
    font-size: 11px;
}

#CodeBlock QPlainTextEdit {
    background-color: #0b1220;
    border: none;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    color: #e2e8f0;
    font-family: "@MONO_FONT@";
    font-size: 12px;
    line-height: 150%;
    padding: 10px 12px;
    selection-background-color: #1e3a5f;
}

/* ───────────────── 真实工具页 ───────────────── */

#ToolPageTitle {
    color: #0f172a;
    font-size: 21px;
    font-weight: 700;
}

#ToolPageSubtitle {
    color: #64748b;
    font-size: 13px;
}

#FieldLabel {
    color: #475569;
    font-size: 12px;
    font-weight: 600;
}

#FieldHint {
    color: #94a3b8;
    font-size: 11px;
}

QLineEdit#ToolInput,
QLineEdit#ToolInputMono,
QSpinBox#ToolInput,
QComboBox#ToolInput {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    color: #0f172a;
    font-size: 13px;
    padding: 7px 10px;
    min-height: 20px;
    selection-background-color: #ccfbf1;
    selection-color: #0f172a;
}

QLineEdit#ToolInputMono {
    font-family: "@MONO_FONT@";
    font-size: 13px;
    letter-spacing: 0.5px;
}

QLineEdit#ToolInput:focus,
QLineEdit#ToolInputMono:focus,
QSpinBox#ToolInput:focus,
QComboBox#ToolInput:focus {
    border: 1px solid #14b8a6;
}

QLineEdit#ToolInput:disabled,
QLineEdit#ToolInputMono:disabled,
QSpinBox#ToolInput:disabled,
QComboBox#ToolInput:disabled {
    background-color: #f8fafc;
    color: #94a3b8;
}

QComboBox#ToolInput::drop-down {
    border: none;
    width: 18px;
}

/* 数字输入框的上下步进按钮：给右侧留 18px，否则箭头会压住数字。 */
QSpinBox#ToolInput,
QDoubleSpinBox#ToolInput {
    padding-right: 20px;
}

QSpinBox#ToolInput::up-button,
QSpinBox#ToolInput::down-button,
QDoubleSpinBox#ToolInput::up-button,
QDoubleSpinBox#ToolInput::down-button {
    subcontrol-origin: border;
    width: 18px;
    border-left: 1px solid #e2e8f0;
    background-color: #f8fafc;
}

QSpinBox#ToolInput::up-button,
QDoubleSpinBox#ToolInput::up-button {
    subcontrol-position: top right;
    border-top-right-radius: 8px;
}

QSpinBox#ToolInput::down-button,
QDoubleSpinBox#ToolInput::down-button {
    subcontrol-position: bottom right;
    border-bottom-right-radius: 8px;
}

QSpinBox#ToolInput::up-arrow,
QDoubleSpinBox#ToolInput::up-arrow {
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 5px solid #64748b;
    width: 0;
    height: 0;
    background: transparent;
}

QSpinBox#ToolInput::down-arrow,
QDoubleSpinBox#ToolInput::down-arrow {
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #64748b;
    width: 0;
    height: 0;
    background: transparent;
}

QSpinBox#ToolInput::up-arrow:disabled,
QSpinBox#ToolInput::down-arrow:disabled,
QDoubleSpinBox#ToolInput::up-arrow:disabled,
QDoubleSpinBox#ToolInput::down-arrow:disabled {
    border-bottom-color: #cbd5e1;
    border-top-color: #cbd5e1;
}

QDoubleSpinBox#ToolInput {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    color: #0f172a;
    font-size: 13px;
    padding: 7px 10px;
    min-height: 20px;
    selection-background-color: #ccfbf1;
    selection-color: #0f172a;
}

QDoubleSpinBox#ToolInput:focus {
    border: 1px solid #14b8a6;
}

QDoubleSpinBox#ToolInput:disabled {
    background-color: #f8fafc;
    color: #94a3b8;
}

QPlainTextEdit#ToolInput {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    color: #0f172a;
    font-family: "@MONO_FONT@";
    font-size: 12px;
    padding: 8px 10px;
    selection-background-color: #ccfbf1;
    selection-color: #0f172a;
}

QPlainTextEdit#ToolInput:focus {
    border: 1px solid #14b8a6;
}

QPushButton#PrimaryButton {
    background-color: #0f766e;
    border: none;
    border-radius: 8px;
    color: #ffffff;
    font-size: 13px;
    font-weight: 600;
    padding: 8px 20px;
    min-height: 20px;
}

QPushButton#PrimaryButton:hover {
    background-color: #115e59;
}

QPushButton#PrimaryButton:pressed {
    background-color: #134e4a;
}

QPushButton#PrimaryButton:disabled {
    background-color: #cbd5e1;
    color: #f8fafc;
}

QPushButton#SecondaryButton {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    color: #475569;
    font-size: 13px;
    font-weight: 600;
    padding: 8px 16px;
    min-height: 20px;
}

QPushButton#SecondaryButton:hover {
    background-color: #f8fafc;
    border-color: #cbd5e1;
}

QPushButton#SecondaryButton:disabled {
    color: #cbd5e1;
}

QPushButton#CopyButton {
    background: transparent;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    color: #64748b;
    font-size: 11px;
    padding: 2px 9px;
    min-height: 18px;
}

QPushButton#CopyButton:hover {
    background-color: #f1f5f9;
    color: #0f766e;
    border-color: #99f6e4;
}

QPushButton#CopyButton:disabled {
    color: #e2e8f0;
    border-color: #f1f5f9;
}

#ResultCaption {
    color: #64748b;
    font-size: 12px;
}

#ResultMono {
    color: #0f172a;
    font-family: "@MONO_FONT@";
    font-size: 13px;
    font-weight: 600;
}

QTableWidget#ResultTable,
QTableView#ResultTable {
    background-color: #ffffff;
    alternate-background-color: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    color: #0f172a;
    font-size: 12px;
    gridline-color: #eef2f7;
    min-height: 140px;
    selection-background-color: #ccfbf1;
    selection-color: #0f172a;
}

QTableWidget#ResultTable::item,
QTableView#ResultTable::item {
    padding: 6px 8px;
}

QTableWidget#ResultTable QHeaderView::section,
QTableView#ResultTable QHeaderView::section {
    background-color: #f8fafc;
    border: none;
    border-bottom: 1px solid #e2e8f0;
    color: #64748b;
    font-size: 11px;
    font-weight: 600;
    padding: 6px 8px;
}

#InlineError {
    background-color: #fef2f2;
    border: 1px solid #fee2e2;
    border-radius: 8px;
    color: #b91c1c;
    font-size: 12px;
    padding: 8px 11px;
}

#ToolSeparator {
    background-color: #eef2f7;
    border: none;
}

/* ───────────────── 状态栏 ───────────────── */

QStatusBar {
    background-color: #ffffff;
    border-top: 1px solid #e2e8f0;
    color: #64748b;
    font-size: 11px;
    min-height: 28px;
}

QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    color: #64748b;
    font-size: 11px;
}

#StatusDotUp {
    color: #0f766e;
    font-weight: 700;
}

#StatusDotIdle {
    color: #94a3b8;
    font-weight: 700;
}

#StatusSeparator {
    color: #e2e8f0;
}

/* ───────────────── 滚动条 ───────────────── */

QScrollArea {
    background: transparent;
    border: none;
}

/* 工具页内容区：卡片背景透出，滚动条只剩右侧细条。 */
#ToolPageScroll,
#ToolPageContent {
    background: transparent;
    border: none;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background-color: #cbd5e1;
    border-radius: 3px;
    min-height: 32px;
}

QScrollBar::handle:vertical:hover {
    background-color: #94a3b8;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background-color: #cbd5e1;
    border-radius: 3px;
    min-width: 32px;
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
    border: none;
    width: 0;
    height: 0;
}

/* ───────────────── 工具提示 ───────────────── */

QToolTip {
    background-color: #0f172a;
    border: none;
    border-radius: 6px;
    color: #f8fafc;
    font-size: 11px;
    padding: 5px 8px;
}